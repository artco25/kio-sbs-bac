// Worker 1: kio-sbs-api — GraphQL de consultas, autenticación, administración y panel KIO SBS.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kio-sbs-backend",
  "main": "src/api/index.ts",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "triggers": { "crons": ["0 8 * * *"] },
  "vars": {
    "APP_NAME": "kio-sbs-api",
    "CORS_ORIGIN": "*",
    "SESSION_DAYS": "30",
    // "true" habilita el auto-registro de empresas desde el login del admin web
    "ALLOW_SIGNUP": "true"
  },
  // Secreto (no va en este archivo):  npx wrangler secret put PROVISION_TOKEN -c wrangler.api.jsonc
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kio-sbs",
      "database_id": "a7e973ce-7adf-4a4b-bd2b-31eda9fa25e1",
      "migrations_dir": "migrations"
    }
  ],
  // Límite de intentos de login: 10 por minuto por IP+correo.
  "ratelimits": [
    { "name": "LOGIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ]
}
